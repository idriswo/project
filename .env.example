# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# ТЗ п. 6: реальные ключи никогда не попадают в git — .env* в .gitignore.

# --- Базовый адрес сайта (нужен для canonical, sitemap, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Приём заявок с формы (Этап 4) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# --- Антиспам: Cloudflare Turnstile (Этап 4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Аналитика (Этап 7) ---
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
