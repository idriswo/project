# Шаблон переменных окружения. Скопируйте в .env.local и заполните.
# ТЗ п. 6: реальные ключи никогда не попадают в git — .env* в .gitignore.

# --- Базовый адрес сайта (нужен для canonical, sitemap, Open Graph) ---
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Бэкенд ---
# Боевой: https://tim.tj/api/v1 (документация — https://tim.tj/docs)
# Локальный бэкенд: http://localhost:5000/api/v1
#
# ВАЖНО: это переменная NEXT_PUBLIC_*, то есть она вшивается в бандл
# на этапе СБОРКИ, а не читается при запуске. Значит, на хостинге её надо
# задать до сборки — иначе в продакшене останется значение по умолчанию.
NEXT_PUBLIC_API_URL=https://tim.tj/api/v1

# --- Supabase (аутентификация) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Приём заявок с формы (Этап 4) ---
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=

# --- Антиспам: Cloudflare Turnstile (Этап 4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Аналитика (Этап 7) ---
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
