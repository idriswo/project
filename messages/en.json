  "faq": {
    "eyebrow": "Questions",
    "title": "The short answers",
    "lead": "If something is missing here, write to us and we will answer.",
    "items": {
      "start": {
        "q": "How long does it take to get going?",
        "a": "Signing up takes a minute, then you add products and start selling. No server to set up, nothing to install, no engineer to call — TIM runs in the browser."
      },
      "training": {
        "q": "Do sellers need training?",
        "a": "The checkout screen works by tapping a size, which drops it into the receipt. One shift is usually enough for someone to work confidently."
      },
      "data": {
        "q": "Where is my data kept and who can see it?",
        "a": "Each shop is kept separate: a staff member sees only their own shop, and only what their role allows. The owner sees everything."
      },
      "offline": {
        "q": "What happens if the internet drops?",
        "a": "Honestly: right now you need a connection. An offline checkout mode is planned, and we would rather not promise it as finished."
      },
      "devices": {
        "q": "What does it run on?",
        "a": "Computer, tablet and phone. Checkout is usually used from a tablet at the counter, reports from a computer."
      },
      "switch": {
        "q": "Everything of mine is in a notebook and a spreadsheet. How do I move over?",
        "a": "Start with the products you sell every day and add the rest as you go. There is no need to move everything at once."
      }
    }
  }
}